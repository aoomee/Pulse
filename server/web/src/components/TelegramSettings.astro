---
import Icon from './Icon.astro';
const { apiBase = '' } = Astro.props;
---
<button id="telegram-settings-btn" class="rounded-lg p-1.5 sm:p-2 text-[#525252] dark:text-[#a3a3a3] hover:bg-black/5 dark:hover:bg-white/5" title="Telegram" aria-label="Telegram"><Icon name="bell" size={18}/></button>
<dialog id="telegram-settings" data-api-base={apiBase} aria-labelledby="tg-title">
<form id="tg-form">
  <header><div><h2 id="tg-title">Telegram</h2><p data-cn="离线提醒 · 恢复通知" data-en="Offline alerts · Recovery notices"></p></div><button type="button" id="tg-close" class="tg-icon" aria-label="Close"><Icon name="x" size={20}/></button></header>
  <div id="tg-loading" role="status" aria-label="Loading"><span class="tg-spinner"></span></div>
  <div id="tg-content" hidden>
    <label class="tg-enable"><span data-cn="启用通知" data-en="Enable notifications"></span><input id="tg-enabled" type="checkbox" role="switch"/></label>
    <div class="tg-fields">
      <label>Bot Token<input id="tg-token" type="password" autocomplete="new-password" maxlength="256" placeholder="123456:ABC…"/></label>
      <label>Chat ID<input id="tg-chat" autocomplete="off" maxlength="128" placeholder="123456789"/></label>
    </div>
    <label id="tg-clear-wrap" class="tg-check" hidden><input id="tg-clear" type="checkbox"/><span data-cn="清除已保存的令牌" data-en="Clear saved token"></span></label>
    <section class="tg-delay"><div><label for="tg-delay-value" data-cn="离线多久提醒" data-en="Offline alert delay"></label><p data-cn="持续失联后提醒，恢复时再通知一次。" data-en="Alert after continuous loss of contact, then once on recovery."></p></div><div class="tg-time"><input id="tg-delay-value" type="number" min="1" max="1440" step="1" value="1" required/><select id="tg-delay-unit" aria-label="Time unit"><option value="60" data-cn="分钟" data-en="minutes"></option><option value="1" data-cn="秒" data-en="seconds"></option></select></div></section>
    <details class="tg-section"><summary data-cn="通知范围" data-en="Servers to notify"></summary><p data-cn="默认通知所有服务器；取消勾选可静音。" data-en="All servers are included by default. Uncheck to mute."></p><div id="tg-hosts"></div></details>
    <details class="tg-section" id="tg-template-section"><summary data-cn="消息模板" data-en="Message template"></summary>
      <p data-cn="默认模板可直接使用。支持 sendMessage / sendEvent，令牌由配置注入。" data-en="Ready to use. Supports sendMessage / sendEvent with credentials supplied by settings."></p>
      <textarea id="tg-script" spellcheck="false" aria-label="JavaScript template" rows="12"></textarea>
      <div class="tg-template-actions"><select id="tg-event" aria-label="Preview event"><option value="Offline" data-cn="离线" data-en="Offline"></option><option value="Online" data-cn="恢复" data-en="Recovery"></option><option value="Test" data-cn="测试" data-en="Test"></option></select><button type="button" id="tg-preview" data-cn="预览" data-en="Preview"></button><button type="button" id="tg-default" data-cn="恢复默认" data-en="Reset template"></button></div>
      <pre id="tg-preview-output" hidden aria-live="polite"></pre>
    </details>
    <p id="tg-feedback" role="status" aria-live="polite"></p>
    <footer><button type="button" id="tg-test" data-cn="发送测试" data-en="Send test"></button><button type="submit" id="tg-save" class="tg-primary" data-cn="保存设置" data-en="Save settings"></button></footer>
  </div>
</form>
</dialog>
<style>
  dialog { --tg-bg:#fff; --tg-ink:#262626; --tg-muted:#737373; --tg-line:#e8e8e8; --tg-soft:#f6f7f7; --tg-accent:#059669; width:min(600px,calc(100% - 32px)); max-height:calc(100dvh - 40px); padding:0; margin:auto; border:1px solid var(--tg-line); border-radius:22px; background:var(--tg-bg); color:var(--tg-ink); box-shadow:0 24px 80px #0002; }
  :global(.dark) dialog { --tg-bg:#1c1c1c; --tg-ink:#f5f5f5; --tg-muted:#a3a3a3; --tg-line:#383838; --tg-soft:#252727; --tg-accent:#10b981; }
  dialog::backdrop { background:#1116; backdrop-filter:blur(4px); } form { padding:28px; } header { display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; }
  h2 { font-size:24px; font-weight:650; letter-spacing:-.6px; } p { font-size:13px; color:var(--tg-muted); line-height:1.6; margin-top:5px; }
  button,input,select,textarea { font:inherit; } button { cursor:pointer; } button:disabled { opacity:.5; cursor:wait; } .tg-icon { display:grid; place-items:center; width:32px; height:32px; border-radius:50%; background:var(--tg-soft); }
  .tg-enable { display:flex; align-items:center; justify-content:space-between; font-size:15px; font-weight:600; margin-bottom:22px; }
  #tg-enabled { appearance:none; width:40px; height:24px; border-radius:20px; background:#bbb; position:relative; cursor:pointer; transition:background .16s; }
  #tg-enabled::after { content:''; position:absolute; top:3px; left:3px; width:18px; height:18px; border-radius:50%; background:white; transition:transform .16s; } #tg-enabled:checked { background:var(--tg-accent); } #tg-enabled:checked::after { transform:translateX(16px); }
  .tg-fields { display:grid; grid-template-columns:1.5fr 1fr; gap:14px; } label { font-size:14px; } .tg-fields label { min-width:0; } .tg-fields input,textarea { display:block; width:100%; margin-top:8px; }
  form { --tg-control-height:44px; --tg-control-radius:14px; }
  input:not([type=checkbox]),select,textarea { background:var(--tg-soft); border:1px solid var(--tg-line); border-radius:var(--tg-control-radius); padding:10px 12px; min-width:0; color:var(--tg-ink); }
  input:not([type=checkbox]),select,.tg-template-actions button,footer button { box-sizing:border-box; height:var(--tg-control-height); border-radius:var(--tg-control-radius); font-size:14px; line-height:20px; }
  :is(input,select,textarea,button,summary):focus-visible { outline:2px solid var(--tg-accent); outline-offset:3px; } .tg-check { display:flex; align-items:center; gap:8px; margin-top:12px; color:var(--tg-muted); } input[type=checkbox] { accent-color:var(--tg-accent); }
  .tg-delay { display:flex; gap:20px; justify-content:space-between; align-items:center; padding:22px 0; margin-top:8px; } .tg-delay label { font-weight:600; } .tg-time { display:flex; flex-shrink:0; gap:6px; } .tg-time input { width:76px; text-align:center; font-variant-numeric:tabular-nums; } .tg-time select { max-width:100px; }
  .tg-section { border-top:1px solid var(--tg-line); padding:16px 0; } summary { font-size:14px; font-weight:550; cursor:pointer; } .tg-section p { margin:10px 0; } #tg-hosts { display:grid; grid-template-columns:1fr 1fr; gap:10px; max-height:180px; overflow:auto; } #tg-hosts :global(label) { display:flex; align-items:center; gap:8px; overflow-wrap:anywhere; }
  textarea { font:12px/1.65 ui-monospace,SFMono-Regular,Consolas,monospace; resize:vertical; min-height:160px; }
  .tg-template-actions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; align-items:center; margin-top:12px; }
  .tg-template-actions button { display:flex; align-items:center; justify-content:center; padding:0 8px; border:1px solid var(--tg-line); background:var(--tg-soft); }
  .tg-template-actions select { width:100%; appearance:none; text-align:center; padding:0 14px 0 2px; background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%); background-position:calc(100% - 9px) 50%,calc(100% - 5px) 50%; background-size:4px 4px; background-repeat:no-repeat; }
  #tg-default { color:var(--tg-muted); }
  pre { white-space:pre-wrap; overflow-wrap:anywhere; font-family:inherit; font-size:13px; line-height:1.7; background:var(--tg-soft); padding:16px; border-radius:var(--tg-control-radius); margin-top:14px; } #tg-feedback { min-height:21px; overflow-wrap:anywhere; } #tg-feedback[data-error=true] { color:#e05252; }
  footer { display:flex; gap:12px; margin-top:16px; } footer button { display:flex; align-items:center; justify-content:center; flex:1; border:1px solid var(--tg-line); padding:0 12px; font-weight:600; } footer .tg-primary { background:var(--tg-accent); border-color:transparent; color:white; }
  [hidden] { display:none!important; } #tg-loading { padding:60px; text-align:center; } .tg-spinner { display:inline-block; width:24px; height:24px; border:2px solid var(--tg-line); border-top-color:var(--tg-accent); border-radius:50%; animation:tg-spin .8s linear infinite; } @keyframes tg-spin { to { transform:rotate(360deg); } }
  @media (max-width:520px) { form { padding:20px; } .tg-fields { grid-template-columns:1fr; } .tg-delay { align-items:flex-start; flex-direction:column; gap:12px; } .tg-time { width:100%; } .tg-time input { flex:1; } }
  @media (prefers-reduced-motion:reduce) { .tg-spinner { animation-duration:2s; } #tg-enabled,#tg-enabled::after { transition:none; } }
</style>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#telegram-settings')!;
  const form = document.querySelector<HTMLFormElement>('#tg-form')!;
  const field = (id: string) => document.getElementById('tg-'+id) as HTMLInputElement;
  const script = document.querySelector<HTMLTextAreaElement>('#tg-script')!;
  const zh = () => localStorage.getItem('preferred-language') === 'zh';
  const tr = (cn:string,en:string) => zh() ? cn : en;
  let defaults = '', excluded:string[] = [], loaded = false, previousUnit = 60;
  function translate() { dialog.querySelectorAll<HTMLElement>('[data-cn]').forEach(el => el.textContent = zh() ? el.dataset.cn! : el.dataset.en!); }
  translate(); window.addEventListener('languagechange',translate);
  function status(text:string,error=false) { field('feedback').textContent=text; field('feedback').dataset.error=String(error); }
  async function api(path:string,data?:unknown) {
    const response = await fetch(`${dialog.dataset.apiBase}/api/${path}`, {method:data===undefined?'GET':'POST',cache:'no-store',headers:{Authorization:`Bearer ${localStorage.getItem('admin_auth_token')||''}`,'Content-Type':'application/json'},...(data===undefined?{}:{body:JSON.stringify(data)})});
    if (!response.ok) throw new Error(response.status===401 ? tr('登录已失效，请重新登录。','Session expired. Please sign in again.') : (await response.text()).slice(0,300));
    return response.json();
  }
  function constrainDelay() { const minutes=field('delay-unit').value==='60'; field('delay-value').min=minutes?'1':'15'; field('delay-value').max=minutes?'1440':'86400'; }
  field('delay-unit').addEventListener('change',()=>{ field('delay-value').value=String(Math.max(field('delay-unit').value==='1'?15:1,Math.ceil(Number(field('delay-value').value)*previousUnit/Number(field('delay-unit').value)))); previousUnit=Number(field('delay-unit').value); constrainDelay(); });
  document.getElementById('telegram-settings-btn')!.addEventListener('click',async()=>{
    translate(); dialog.showModal(); loaded=false; field('loading').hidden=false; field('content').hidden=true; status('');
    try {
      const result=await api('telegram/config'), c=result.config;
      defaults=result.default_script; excluded=c.excluded_ids||[]; field('enabled').checked=c.enabled; field('token').value=''; field('clear').checked=false;
      field('token').placeholder=result.has_token?tr('已保存，留空不修改','Saved; leave blank to keep'):'123456:ABC…'; field('clear-wrap').hidden=!result.has_token; field('chat').value=c.chat_id||'';
      field('delay-unit').value=c.offline_seconds%60===0?'60':'1'; previousUnit=Number(field('delay-unit').value); field('delay-value').value=String(c.offline_seconds/previousUnit); constrainDelay(); script.value=c.script; field('preview-output').hidden=true;
      const hosts=field('hosts'); hosts.replaceChildren();
      try { const metrics=await api('metrics'); for(const host of metrics) { const label=document.createElement('label'),check=document.createElement('input'); check.type='checkbox'; check.value=host.id; check.checked=!excluded.includes(host.id); label.append(check,document.createTextNode(host.name||host.id)); hosts.append(label); } if(!metrics.length) hosts.textContent=tr('暂无服务器，新服务器将默认启用通知。','No servers yet. New servers will be included.'); }
      catch { hosts.textContent=tr('列表暂不可用，原有通知范围将保留。','Server list unavailable. Existing choices will be kept.'); }
      loaded=true; status(result.last_error||'');
    } catch(e) { status((e as Error).message,true); }
    finally { field('loading').hidden=true; field('content').hidden=false; field('save').disabled=!loaded; field('test').disabled=!loaded; }
  });
  field('close').addEventListener('click',()=>dialog.close()); dialog.addEventListener('close',()=>{field('token').value='';});
  function config() {
    if(!loaded||!form.reportValidity()) return null;
    const seconds=Number(field('delay-value').value)*Number(field('delay-unit').value);
    if(!Number.isInteger(seconds)||seconds<15||seconds>86400) { status(tr('等待时间须为 15 秒至 24 小时。','Delay must be between 15 seconds and 24 hours.'),true); return null; }
    const chosen=new Set(excluded); dialog.querySelectorAll<HTMLInputElement>('#tg-hosts input').forEach(check=>check.checked?chosen.delete(check.value):chosen.add(check.value));
    return {enabled:field('enabled').checked,bot_token:field('token').value.trim(),clear_token:field('clear').checked,chat_id:field('chat').value.trim(),offline_seconds:seconds,script:script.value,excluded_ids:[...chosen],event:field('event').value};
  }
  async function act(action:string) {
    const data=config(); if(!data) return;
    const controls=[...dialog.querySelectorAll<HTMLInputElement>('input,select,textarea,button')]; controls.forEach(el=>el.disabled=true); status(tr('处理中…','Working…'));
    try {
      const result=await api(`telegram/${action}`,data);
      if(action==='preview') { field('preview-output').textContent=result.messages.map((message:string)=>new DOMParser().parseFromString(message.replace(/<[^>]*>/g,''),'text/html').body.textContent).join('\n\n────────\n\n'); field('preview-output').hidden=false; status(''); }
      else if(action==='config') { if(data.bot_token) field('clear-wrap').hidden=false; else if(data.clear_token) field('clear-wrap').hidden=true; field('token').value=''; field('clear').checked=false; field('token').placeholder=field('clear-wrap').hidden?'123456:ABC…':tr('已保存，留空不修改','Saved; leave blank to keep'); status(tr('设置已保存。','Settings saved.')); }
      else status(tr('测试消息已发送。','Test message sent.'));
    } catch(e) { status((e as Error).message,true); } finally { controls.forEach(el=>el.disabled=false); }
  }
  form.addEventListener('submit',e=>{e.preventDefault();void act('config');}); field('preview').addEventListener('click',()=>void act('preview')); field('test').addEventListener('click',()=>void act('test'));
  field('default').addEventListener('click',()=>{if(confirm(tr('恢复默认消息模板？','Restore the default message template?'))) script.value=defaults;});
</script>
